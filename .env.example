# Copy to .env (never commit it) or to /etc/tplink-easysmart-mcp.env (mode 0600).
# Every value is a placeholder; 192.0.2.10 is an RFC 5737 documentation address.
# The switch speaks cleartext HTTP on the LAN only: run this server on the wired
# LAN host, never across an untrusted network.

# --- Switch connection ----------------------------------------------------
EASYSMART_HOST=192.0.2.10
# Scheme is always http; :80 by default.
EASYSMART_PORT=80
EASYSMART_USERNAME=admin
# 6-16 characters, no spaces. Validated at startup so a bad value never reaches
# the device (a rejected login would trip the switch's lockout).
EASYSMART_PASSWORD=<your-switch-password>
# TLS is not available on this device; VERIFY_TLS / TLS_FINGERPRINT_SHA256 are
# rejected if set.
EASYSMART_TIMEOUT_S=5

# --- Safety switches ------------------------------------------------------
# Writes need this AND confirm_write=true on each call.
EASYSMART_ALLOW_WRITES=false
# Return the exact write request without sending it.
EASYSMART_DRY_RUN=false
# Freeze authentication entirely: no login attempt is made while true.
EASYSMART_LOGIN_DISABLED=false
# Breaker and cooldown state files. Default ~/.local/state/tplink-easysmart-mcp/.
EASYSMART_STATE_DIR=~/.local/state/tplink-easysmart-mcp

# --- Port policy ----------------------------------------------------------
# PoE-capable ports (ranges and commas). A PoE write requires the port to be here.
EASYSMART_POE_PORTS=1-8
# The uplink and the server's own port. REQUIRED (non-empty) when ALLOW_WRITES=true.
EASYSMART_PROTECTED_PORTS=16,15
# Friendly names: name=port;name=port. Names match [A-Za-z0-9_.-]{1,32}.
EASYSMART_PORT_MAP=cam_hall=1;cam_gate=2

# --- Login rate limiting and power cycle ----------------------------------
# Minimum gap (seconds) between a failed/unconfirmed login and the next attempt.
EASYSMART_LOGIN_COOLDOWN_S=300
# Bounds for poe_cycle off_seconds.
EASYSMART_CYCLE_OFF_MIN_S=5
EASYSMART_CYCLE_OFF_MAX_S=120
# How long to wait for powerstatus==on after re-enabling a port.
EASYSMART_CYCLE_POWER_TIMEOUT_S=60
# If true, read tools also log out (use when the owner works in the web UI often).
EASYSMART_LOGOUT_AFTER_READS=false

# --- MCP server -----------------------------------------------------------
# stdio | streamable-http
EASYSMART_MCP_TRANSPORT=stdio
EASYSMART_MCP_HOST=127.0.0.1
EASYSMART_MCP_PORT=8766
# EASYSMART_MCP_LOG_LEVEL=INFO
